{
  "name": "@scr-runtime/runtime",
  "version": "1.0.1",
  "description": "Screen Control Runtime (SCR) — Production-grade runtime for AI agents to observe and control graphical applications.",
  "license": "MIT",
  "author": "Harshit Gavita",
  "type": "module",

  "homepage": "https://github.com/harshitgavita-07/SCR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshitgavita-07/SCR.git"
  },
  "bugs": {
    "url": "https://github.com/harshitgavita-07/SCR/issues"
  },

  "publishConfig": {
    "access": "public"
  },

  "sideEffects": false,

  "engines": {
    "node": ">=22"
  },

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./planner": {
      "types": "./dist/planner/index.d.ts",
      "import": "./dist/planner/index.js",
      "require": "./dist/planner/index.cjs"
    },
    "./observer": {
      "types": "./dist/observer/index.d.ts",
      "import": "./dist/observer/index.js",
      "require": "./dist/observer/index.cjs"
    },
    "./verifier": {
      "types": "./dist/verifier/index.d.ts",
      "import": "./dist/verifier/index.js",
      "require": "./dist/verifier/index.cjs"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "require": "./dist/actions/index.cjs"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "import": "./dist/sessions/index.js",
      "require": "./dist/sessions/index.cjs"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "require": "./dist/registry/index.cjs"
    },
    "./targets/chromium": {
      "types": "./dist/targets/chromium/index.d.ts",
      "import": "./dist/targets/chromium/index.js",
      "require": "./dist/targets/chromium/index.cjs"
    },
    "./targets/terminal": {
      "types": "./dist/targets/terminal/index.d.ts",
      "import": "./dist/targets/terminal/index.js",
      "require": "./dist/targets/terminal/index.cjs"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "require": "./dist/sdk/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "require": "./dist/events/index.cjs"
    },
    "./package.json": "./package.json"
  },

  "bin": {
    "scr": "./dist/cli/bin.js"
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",

    "typecheck": "tsc --noEmit",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "docs": "typedoc --options typedoc.json",

    "clean": "rimraf dist coverage",

    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },

  "keywords": [
    "scr",
    "automation",
    "browser",
    "playwright",
    "runtime",
    "ai",
    "agent",
    "desktop",
    "mobile",
    "testing"
  ],

  "dependencies": {
    "@playwright/test": "^1.61.1",
    "commander": "^12.1.0",
    "pino": "^9.14.0",
    "playwright": "^1.61.1",
    "zod": "^3.25.0"
  },

  "peerDependencies": {
    "typescript": ">=5.0.0"
  },

  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.26.11",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
