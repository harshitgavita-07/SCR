{
  "name": "@scr/mcp-server",
  "version": "0.1.0",
  "description": "MCP Server for SCR Runtime - Model Context Protocol adapter",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "scr-mcp-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/bin.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scr",
    "ai-agents",
    "automation"
  ],
  "author": "SCR Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scr/runtime.git",
    "directory": "packages/mcp-server"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@scr/runtime": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
